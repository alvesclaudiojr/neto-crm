# Copie para .env e preencha com os dados do projeto Supabase
# (Project Settings > API). A "anon key" é pública por design: quem protege
# os dados são as regras RLS do banco, não o segredo desta chave.
# NUNCA coloque aqui a service_role key.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
